              "                    <p>पंखे की हवा और ठंडे पानी की तलब,</p>\n",
              "                    <p>आराम की घड़ी, काम से विलम्ब।</p>\n",
              "                    <p>दोपहर की नींद में मीठे सपने,</p>\n",
              "                    <p>थकान मिटाती ये पल अपने।</p>\n",
              "                </div>\n",
              "                <div class=\"nav-buttons\">\n",
              "                    <button class=\"btn btn-secondary\" onclick=\"showPoem(5)\">← पिछली</button>\n",
              "                    <button class=\"btn btn-primary\" onclick=\"showPoem(7)\">अगली →</button>\n",
              "                </div>\n",
              "            </div>\n",
              "\n",
              "            <!-- Poem 7: घोंसला -->\n",
              "            <div class=\"section\" id=\"poem7\">\n",
              "                <div class=\"section-title editable\" contenteditable=\"false\" data-key=\"poem7Title\">7. घोंसला</div>\n",
              "                <div class=\"sketch-container\">\n",
              "                    <svg viewBox=\"0 0 400 300\" class=\"poem-sketch\">\n",
              "                        <rect width=\"400\" height=\"300\" fill=\"#a8e6cf\"/>\n",
              "                        <rect x=\"150\" y=\"50\" width=\"40\" height=\"200\" fill=\"#8B4513\" stroke=\"#000\" stroke-width=\"2\"/>\n",
              "                        <ellipse cx=\"170\" cy=\"40\" rx=\"60\" ry=\"50\" fill=\"#27ae60\" stroke=\"#000\" stroke-width=\"1.5\"/>\n",
              "                        <ellipse cx=\"220\" cy=\"110\" rx=\"40\" ry=\"25\" fill=\"#8B4513\" stroke=\"#000\" stroke-width=\"2\"/>\n",
              "                        <circle cx=\"225\" cy=\"105\" r=\"8\" fill=\"#87CEEB\" stroke=\"#000\" stroke-width=\"1\"/>\n",
              "                    </svg>\n",
              "                </div>\n",
              "                <div class=\"poem-content editable\" contenteditable=\"false\" data-key=\"poem7Content\">\n",
              "                    <p>पेड़ की डाली पर बना छोटा सा घर,</p>\n",
              "                    <p>तिनके-तिनके जोड़ा है बड़े जतन से भर।</p>\n",
              "                    <p>चिड़िया का यह घोंसला प्यारा,</p>\n",
              "                    <p>ममता और परिश्रम का सहारा।</p>\n",
              "                    <br>\n",
              "                    <p>अंडों को सेती माँ रात-दिन,</p>\n",
              "                    <p>सुरक्षा देती हर पल, हर क्षण।</p>\n",
              "                    <p>घोंसले में है परिवार का प्यार,</p>\n",
              "                    <p>जीवन का यह अद्भुत संसार।</p>\n",
              "                </div>\n",
              "                <div class=\"nav-buttons\">\n",
              "                    <button class=\"btn btn-secondary\" onclick=\"showPoem(6)\">← पिछली</button>\n",
              "                    <button class=\"btn btn-primary\" onclick=\"showPoem(8)\">अगली →</button>\n",
              "                }\n",
              "            </div>\n",
              "\n",
              "            <!-- Poem 8: साँझ -->\n",
              "            <div class=\"section\" id=\"poem8\">\n",
              "                <div class=\"section-title editable\" contenteditable=\"false\" data-key=\"poem8Title\">8. साँझ</div>\n",
              "                <div class=\"sketch-container\">\n",
              "                    <svg viewBox=\"0 0 400 300\" class=\"poem-sketch\">\n",
              "                        <defs>\n",
              "                            <linearGradient id=\"eveningSky\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n",
              "                                <stop offset=\"0%\" style=\"stop-color:#ff7675\"/>\n",
              "                                <stop offset=\"50%\" style=\"stop-color:#fd79a8\"/>\n",
              "                                <stop offset=\"100%\" style=\"stop-color:#fdcb6e\"/>\n",
              "                            </linearGradient>\n",
              "                        </defs>\n",
              "                        <rect width=\"400\" height=\"300\" fill=\"url(#eveningSky)\"/>\n",
              "                        <circle cx=\"100\" cy=\"100\" r=\"50\" fill=\"#ff6348\" opacity=\"0.8\" stroke=\"#000\" stroke-width=\"1\"/>\n",
              "                        <path d=\"M0,200 Q100,180 200,190 T400,180 L400,300 L0,300 Z\" fill=\"#2d3436\" stroke=\"#000\" stroke-width=\"1\"/>\n",
              "                        <ellipse cx=\"150\" cy=\"210\" rx=\"20\" ry=\"30\" fill=\"#000\"/>\n",
              "                        <path d=\"M300,150 Q305,145 310,150\" stroke=\"#000\" fill=\"none\" stroke-width=\"1.5\"/>\n",
              "                    </svg>\n",
              "                </div>\n",
              "                <div class=\"poem-content editable\" contenteditable=\"false\" data-key=\"poem8Content\">\n",
              "                    <p>सूरज ढल रहा पश्चिम की ओर,</p>\n",
              "                    <p>साँझ की बेला लाती शांति और मोर।</p>\n",
              "                    <p>आकाश रंग बदलता है हर पल,</p>\n",
              "                    <p>गुलाबी, नारंगी में होता उजल।</p>\n",
              "                    <br>\n",
              "                    <p>पक्षी लौटते अपने घोंसलों को,</p>\n",
              "                    <p>किसान घर आते खेतों से खो।</p>\n",
              "                    <p>साँझ की यह मनमोहक छटा,</p>\n",
              "                    <p>दिन और रात के बीच की कड़ी है यह सटा।</p>\n",
              "                </div>\n",
              "                <div class=\"nav-buttons\">\n",
              "                    <button class=\"btn btn-secondary\" onclick=\"showPoem(7)\">← पिछली</button>\n",
              "                    <button class=\"btn btn-primary\" onclick=\"showPoem(9)\">अगली →</button>\n",
              "                }\n",
              "            </div>\n",
              "\n",
              "            <!-- Poem 9: सूर्यास्त -->\n",
              "            <div class=\"section\" id=\"poem9\">\n",
              "                <div class=\"section-title editable\" contenteditable=\"false\" data-key=\"poem9Title\">9. सूर्यास्त</div>\n",
              "                <div class=\"sketch-container\">\n",
              "                    <svg viewBox=\"0 0 400 300\" class=\"poem-sketch\">\n",
              "                        <defs>\n",
              "                            <linearGradient id=\"sunsetSky\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n",
              "                                <stop offset=\"0%\" style=\"stop-color:#e17055\"/>\n",
              "                                <stop offset=\"50%\" style=\"stop-color:#fd79a8\"/>\n",
              "                                <stop offset=\"100%\" style=\"stop-color:#fdcb6e\"/>\n",
              "                            </linearGradient>\n",
              "                        </defs>\n",
              "                        <rect width=\"400\" height=\"300\" fill=\"url(#sunsetSky)\"/>\n",
              "                        <circle cx=\"200\" cy=\"200\" r=\"60\" fill=\"#ff6348\" stroke=\"#000\" stroke-width=\"1.5\"/>\n",
              "                        <line x1=\"0\" y1=\"200\" x2=\"400\" y2=\"200\" stroke=\"#2d3436\" stroke-width=\"3\"/>\n",
              "                        <path d=\"M0,200 L0,300 L400,300 L400,200 Q200,205 0,200\" fill=\"#0984e3\" opacity=\"0.6\" stroke=\"#000\" stroke-width=\"1\"/>\n",
              "                    </svg>\n",
              "                </div>\n",
              "                <div class=\"poem-content editable\" contenteditable=\"false\" data-key=\"poem9Content\">\n",
              "                    <p>क्षितिज को चूमता सूरज डूब रहा,</p>\n",
              "                    <p>दिन का अंत, प्रकृति नमन कर रहा।</p>\n",
              "                    <p>सुनहरी किरणें बिखरती जल में,</p>\n",
              "                    <p>सूर्यास्त का दृश्य मन में बस रहा।</p>\n",
              "                    <br>\n",
              "                    <p>लाल-पीली आभा फैली चारों ओर,</p>\n",
              "                    <p>प्रकृति का यह अद्भुत श्रृंगार और शोर।</p>\n",
              "                    <p>सूर्यास्त देखना ध्यान का क्षण है,</p>\n",
              "                    <p>जीवन की नश्वरता का ज्ञान है।</p>\n",
              "                </div>\n",
              "                <div class=\"nav-buttons\">\n",
              "                    <button class=\"btn btn-secondary\" onclick=\"showPoem(8)\">← पिछली</button>\n",
              "                    <button class=\"btn btn-primary\" onclick=\"showPoem(10)\">अगली →</button>\n",
              "                }\n",
              "            </div>\n",
              "\n",
              "            <!-- Poem 10: रात्रि -->\n",
              "            <div class=\"section\" id=\"poem10\">\n",
              "                <div class=\"section-title editable\" contenteditable=\"false\" data-key=\"poem10Title\">10. रात्रि</div>\n",
              "                <div class=\"sketch-container\">\n",
              "                    <svg viewBox=\"0 0 400 300\" class=\"poem-sketch\">\n",
              "                        <rect width=\"400\" height=\"300\" fill=\"#0c2461\"/>\n",
              "                        <circle cx=\"320\" cy=\"60\" r=\"30\" fill=\"#f8f9fa\" stroke=\"#000\" stroke-width=\"1\"/>\n",
              "                        <circle cx=\"325\" cy=\"55\" r=\"25\" fill=\"#0c2461\"/>\n",
              "                        <circle cx=\"100\" cy=\"80\" r=\"2\" fill=\"#fff\"/>\n",
              "                        <circle cx=\"150\" cy=\"60\" r=\"2\" fill=\"#fff\"/>\n",
              "                        <circle cx=\"200\" cy=\"90\" r=\"2\" fill=\"#fff\"/>\n",
              "                        <path d=\"M0,200 Q100,180 200,190 T400,185 L400,300 L0,300 Z\" fill=\"#1a1a2e\" stroke=\"#000\" stroke-width=\"1\"/>\n",
              "                        <rect x=\"80\" y=\"220\" width=\"50\" height=\"60\" fill=\"#2d3436\" stroke=\"#000\" stroke-width=\"1.5\"/>\n",
              "                    </svg>\n",
              "                </div>\n",
              "                <div class=\"poem-content editable\" contenteditable=\"false\" data-key=\"poem10Content\">\n",
              "                    <p>जब अंधकार छा जाता\n",
              "            <div class=\"section\" id=\"aboutPoet\">\n",
              "                <div class=\"section-title editable\" contenteditable=\"false\" data-key=\"aboutPoetTitle\">कवि परिचय</div>\n",
              "                <div class=\"about-poet\">\n",
              "                    <h3 class=\"editable\" contenteditable=\"false\" data-key=\"aboutPoetName\" style=\"text-align: center; margin-bottom: 20px; color: #764ba2; font-size: 1.8em;\">बुक्कन</h3>\n",
              "                    <div class=\"intro-text editable\" contenteditable=\"false\" data-key=\"aboutPoetText\">\n",
              "                        <p>बुक्कन एक समकालीन हिंदी कवि हैं जो अपनी सरल भाषा और गहन भावनाओं के लिए जाने जाते हैं। उनकी कविताएं जीवन के विभिन्न पहलुओं को छूती हैं - प्रकृति की सुंदरता से लेकर मानवीय रिश्तों की गहराई तक।</p>\n",
              "                        <br>\n",
              "                        <p>ग्रामीण परिवेश में पले-बढ़े बुक्कन की कविताओं में भारतीय संस्कृति और परंपराओं की सुगंध मिलती है। वे अपनी रचनाओं के माध्यम से पाठकों को उनकी जड़ों से जोड़ने का प्रयास करते हैं।</p>\n",
              "                        <br>\n",
              "                        <p>\"मेरी इक्कीस कविताएं\" उनका प्रथम काव्य संग्रह है जो जीवन के सरल सत्य और प्रकृति के साथ मनुष्य के गहरे संबंध को दर्शाता है।</p>\n",
              "                    </div>\n",
              "                </div>\n",
              "                <div class=\"nav-buttons\">\n",
              "                    <button class=\"btn btn-secondary\" onclick=\"showPoem(21)\">← पीछे</button>\n",
              "                    <button class=\"btn btn-primary\" onclick=\"showSection('acknowledgment')\">आभार →</button>\n",
              "                </div>\n",
              "            </div>\n",
              "\n",
              "            <!-- Acknowledgment -->\n",
              "            <div class=\"section\" id=\"acknowledgment\">\n",
              "                <div class=\"section-title editable\" contenteditable=\"false\" data-key=\"acknowledgmentTitle\">आभार</div>\n",
              "                <div class=\"intro-text editable\" contenteditable=\"false\" data-key=\"acknowledgmentText\">\n",
              "                    <p>इस काव्य संग्रह को पूर्ण करने में अनेक व्यक्तियों का योगदान रहा है।</p>\n",
              "                    <br>\n",
              "                    <p>सर्वप्रथम मैं अपने माता-पिता का आभारी हूँ जिन्होंने मुझे संस्कार और प्रकृति से प्रेम करना सिखाया। मेरे गुरुजनों का आभार जिन्होंने साहित्य के प्रति रुचि जगाई।</p>\n",
              "                    <br>\n",
              "                    <p>मैं अपने मित्रों और परिवार का धन्यवाद करता हूँ जिन्होंने मेरी रचनाओं को पढ़ा और उत्साहवर्धन किया। विशेष आभार उन सभी पाठकों का जिन्होंने इस पुस्तक को हाथ में लिया।</p>\n",
              "                    <br>\n",
              "                    <p>अंत में, प्रकृति और जीवन के प्रति आभार जिन्होंने मुझे ये कविताएं लिखने की प्रेरणा दी।</p>\n",
              "                    <br>\n",
              "                    <p style=\"text-align: right;\">- बुक्कन</p>\n",
              "                </div>\n",
              "                <div class=\"nav-buttons\">\n",
              "                    <button class=\"btn btn-secondary\" onclick=\"showSection('aboutPoet')\">← पीछे</button>\n",
              "                    <button class=\"btn btn-primary\" onclick=\"showSection('endPage')\">समाप्ति →</button>\n",
              "                </div>\n",
              "            </div>\n",
              "\n",
              "            <!-- End Page -->\n",
              "            <div class=\"section\" id=\"endPage\">\n",
              "                <div style=\"text-align: center; padding: 80px 20px;\">\n",
              "                    <h2 style=\"font-size: 2.5em; color: #764ba2; margin-bottom: 40px; font-family: 'Noto Serif Devanagari', serif;\">समाप्त</h2>\n",
              "                    <p class=\"editable\" contenteditable=\"false\" data-key=\"endPageText\" style=\"font-size: 1.4em; color: #666; margin: 30px 0;\">धन्यवाद</p>\n",
              "                    <br><br>\n",
              "                    <div style=\"border-top: 2px solid #764ba2; padding-top: 30px; margin-top: 50px;\">\n",
              "                        <p style=\"font-size: 1.1em; color: #888;\">पुस्तक समाप्त</p>\n",
              "                        <p style=\"font-size: 0.9em; color: #aaa; margin-top: 20px;\">© 2026 बुक्कन | सर्वाधिकार सुरक्षित</p>\n",
              "                    </div>\n",
              "                </div>\n",
              "                <button class=\"download-btn\" onclick=\"downloadBook()\">📥 पुस्तक PDF डाउनलोड करें</button>\n",
              "                <div class=\"nav-buttons\" style=\"margin-top: 20px;\">\n",
              "                    <button class=\"btn btn-secondary\" onclick=\"showSection('titlePage')\">प्रारंभ पर जाएं</button>\n",
              "                    <button class=\"btn btn-primary\" onclick=\"showSection('toc')\">विषय सूची</button>\n",
              "                </div>\n",
              "            </div>\n",
              "        </div>\n",
              "\n",
              "        <div class=\"copyright\">\n",
              "            <p>© 2026 बुक्कन | सर्वाधिकार सुरक्षित</p>\n",
              "            <p>इस पुस्तक का कोई भी भाग लेखक की अनुमति के बिना पुनः प्रकाशित नहीं किया जा सकता।</p>\n",
              "        </div>\n",
              "    </div>\n",
              "\n",
              "    <script>\n",
              "        let isEditMode = false;\n",
              "        let isPaid = false;\n",
              "\n",
              "        // Load saved content from memory\n",
              "        const savedContent = {};\n",
              "\n",
              "        function showLockedMessage() {\n",
              "            if (!isPaid) {\n",
              "                showSection('locked');\n",
              "            }\n",
              "        }\n",
              "\n",
              "        function verifyPayment() {\n",
              "            const txnId = document.getElementById('txnId').value;\n",
              "\n",
              "            if (!txnId || txnId.trim() === '') {\n",
              "                alert('कृपया लेनदेन ID दर्ज करें।');\n",
              "                return;\n",
              "            }\n",
              "\n",
              "            // Simulate payment verification\n",
              "            alert('भुगतान सत्यापन प्रक्रिया में है...\\n\\nनोट: यह एक डेमो है। वास्तविक परिदृश्य में, यहां सर्वर-साइड भुगतान सत्यापन होगा।');\n",
              "\n",
              "            // Unlock all poems\n",
              "            isPaid = true;\n",
              "            document.querySelectorAll('.locked-poem').forEach(poem => {\n",
              "                poem.classList.remove('locked-poem');\n",
              "            });\n",
              "\n",
              "            // Update TOC to remove locks\n",
              "            const tocItems = document.querySelectorAll('.toc li');\n",
              "            tocItems.forEach((item, index) => {\n",
              "                if (index >= 3) {\n",
              "                    const oldOnClick = item.getAttribute('onclick');\n",
              "                    if (oldOnClick && oldOnClick.includes('showLockedMessage')) {\n",
              "                        item.setAttribute('onclick', `showPoem(${index + 1})`);\n",
              "                        item.innerHTML = item.innerHTML.replace(' 🔒', '');\n",
              "                    }\n",
              "                }\n",
              "            });\n",
              "\n",
              "            alert('✓ भुगतान सफल!\\n\\nसभी कविताएं अब अनलॉक हो गई हैं। आप पूरी पुस्तक पढ़ सकते हैं।');\n",
              "            showPoem(4);\n",
              "        }\n",
              "\n",
              "        function toggleEditMode() {\n",
              "            isEditMode = !isEditMode;\n",
              "            const container = document.querySelector('.container');\n",
              "            const editables = document.querySelectorAll('.editable');\n",
              "            const toggleBtn = document.querySelector('.edit-mode-toggle');\n",
              "\n",
              "            if (isEditMode) {\n",
              "                container.classList.add('edit-mode');\n",
              "                editables.forEach(el => {\n",
              "                    el.contentEditable = 'true';\n",
              "                    // Load saved content if exists\n",
              "                    const key = el.dataset.key;\n",
              "                    if (savedContent[key]) {\n",
              "                        el.innerHTML = savedContent[key];\n",
              "                    }\n",
              "                });\n",
              "                toggleBtn.textContent = '💾 सहेजें और बंद करें';\n",
              "                toggleBtn.style.background = '#10b981';\n",
              "            } else {\n",
              "                container.classList.remove('edit-mode');\n",
              "                editables.forEach(el => {\n",
              "                    el.contentEditable = 'false';\n",
              "                    // Save content\n",
              "                    const key = el.dataset.key;\n",
              "                    savedContent[key] = el.innerHTML;\n",
              "                });\n",
              "                toggleBtn.textContent = '✏️ संपादन मोड';\n",
              "                toggleBtn.style.background = '#f093fb';\n",
              "                showSaveNotice();\n",
              "            }\n",
              "        }\n",
              "\n",
              "        function showSaveNotice() {\n",
              "            const notice = document.getElementById('saveNotice');\n",
              "            notice.classList.add('show');\n",
              "            setTimeout(() => {\n",
              "                notice.classList.remove('show');\n",
              "            }, 2000);\n",
              "        }\n",
              "\n",
              "        function showSection(sectionId) {\n",
              "            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));\n",
              "            document.getElementById(sectionId).classList.add('active');\n",
              "            window.scrollTo({top: 0, behavior: 'smooth'});\n",
              "        }\n",
              "\n",
              "        function showPoem(num) {\n",
              "            if (num > 3 && !isPaid) {\n",
              "                showLockedMessage();\n",
              "                return;\n",
              "            }\n",
              "            showSection('poem' + num);\n",
              "        }\n",
              "\n",
              "        function downloadBook() {\n",
              "            alert('डाउनलोड शुरू हो रहा है...\\n\\nयह पुस्तक का पूर्ण संस्करण PDF फॉर्मेट में डाउनलोड होगा।\\n\\nध्यान दें: आपके द्वारा संपादित सामग्री PDF में शामिल होगी।');\n",
              "            window.print();\n",
              "        }\n",
              "\n",
              "        // Auto-save every 30 seconds when in edit mode\n",
              "        setInterval(() => {\n",
              "            if (isEditMode) {\n",
              "                const editables = document.querySelectorAll('.editable');\n",
              "                editables.forEach(el => {\n",
              "                    const key = el.dataset.key;\n",
              "                    savedContent[key] = el.innerHTML;\n",
              "                });\n",
              "            }\n",
              "        }, 30000);\n",
              "    </script>\n",
              "</body>\n",
              "</html>\n"
            ]
          },
          "metadata": {}
        }
      ],
      "source": [
        "%%html\n",
        "<!DOCTYPE html>\n",
        "<html lang=\"hi\">\n",
        "<head>\n",
